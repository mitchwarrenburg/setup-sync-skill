{
  "_about": [
    "Track vocabulary for setup-sync. Keys under 'tracks' are destination folder names (Capitalized, spaced).",
    "aliases: matched as contiguous token runs anywhere in a name (case, accents, punctuation and camelCase ignored).",
    "exact: matched only when a whole folder name equals it; always an explicit layout (iRacing track dirnames).",
    "base=false: the family name is never a destination; a variant must be determined or the file is unresolved.",
    "variants.split: 'always' = own folder; 'if-exists' = own folder only when the team already has one, else the base.",
    "markers: layout words elsewhere in the path or file name that pick a variant.",
    "weak_markers: weaker evidence (series names, loose words such as Nordschleife); any layout marker outranks them.",
    "rules: learned overrides, first match wins. pattern is a case-insensitive regex on the car-relative path with '/' separators."
  ],
  "ignore_tokens": [
    "circuit", "circuito", "international", "internacional", "raceway", "speedway", "motor", "motorsport",
    "motorsports", "course", "full", "fullcourse", "road", "the", "de", "des", "du", "do", "of", "at", "park",
    "autodromo", "nazionale", "internazionale", "pits", "gp", "grand", "prix", "grandprix", "track", "world"
  ],
